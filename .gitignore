# ---- ESP-IDF 编译产物（体积大且可重新生成，不入库）----
build/
**/build/
managed_components/
**/managed_components/
sdkconfig.old
*.bin
*.elf
*.map
*.bin_timestamp
.ninja_deps
.ninja_log
flash_args
flasher_args.json
project_description.json
compile_commands.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.venv-asr/
.pytest_cache/

# ---- 第5周：语音链路 ----
# 识别模型是第三方资产（40MB+），只记来源与校验和，不入库
week1/tools/models/
# 运行时录音与合成音频，每次内容都不同
week1/audio/

# ---- SQLite 运行期临时文件 ----
# readings.db 本身是实测数据、要入库；journal/wal/shm 是写入中途或进程被强杀
# 之后留下的残留（服务器没正常退出就会有），每次内容都不同，不入库
*.db-journal
*.db-wal
*.db-shm

# ---- WorkBuddy 会话工作数据（内部状态，不入库）----
# 本目录下的每日工作日志已整理归档到 docs/worklog/，可复现脚本在 docs/worklog/README.md 中说明
.workbuddy/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件 ----
*.tmp
*.log.tmp
*_bak/
*.bak
~$*
